{
  "name": "qvac-vision-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QVAC Vision Lab — local-first, evidence-driven vision model evaluation",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:provider": "node scripts/smoke-provider.mjs",
    "verify:qvac-visionpsy": "node scripts/verify-qvac-visionpsy-018.mjs",
    "verify:qvac-visionpsy-three-way": "node scripts/verify-qvac-visionpsy-three-way.mjs",
    "showcase:test:three-way": "node scripts/run-showcase-three-way-api.mjs",
    "showcase:test:validation-three-way": "QVAC_SHOWCASE_SUITE=validation-real node scripts/run-showcase-three-way-api.mjs",
    "showcase:test:validation-b-three-way": "QVAC_SHOWCASE_SUITE=validation-real-b node scripts/run-showcase-three-way-api.mjs",
    "showcase:test:validation-c-three-way": "QVAC_SHOWCASE_SUITE=validation-real-c node scripts/run-showcase-three-way-api.mjs",
    "showcase:test:remainder-three-way": "QVAC_SHOWCASE_SUITE=official-remainder QVAC_SHOWCASE_RESUME=1 node scripts/run-showcase-three-way-api.mjs",
    "showcase:test:official-all-three-way": "QVAC_SHOWCASE_SUITE=official-all node scripts/run-showcase-three-way-api.mjs",
    "showcase:test:official-all-qvac-unified": "QVAC_SHOWCASE_SUITE=official-all QVAC_SHOWCASE_RUN_ID=qvac-sdk-unified-0182 QVAC_SHOWCASE_RESUME=1 node scripts/run-showcase-three-way-api.mjs",
    "showcase:install:realworldqa": "node scripts/install-realworldqa-complete.mjs",
    "showcase:report:realworldqa-765": "node scripts/build-showcase-realworldqa-765-report.mjs",
    "showcase:report:realworldqa-765-qvac-unified": "node scripts/build-showcase-realworldqa-unified-audit.mjs",
    "showcase:audit:vlmeval-parity": "node scripts/audit-showcase-vlmeval-parity.mjs",
    "showcase:audit:vlmeval-parity-qvac-unified": "QVAC_VLMEVAL_INPUT=visionpsy-three-way-realworldqa-765-qvac-sdk-unified-0182.json QVAC_VLMEVAL_OUTPUT_STEM=visionpsy-realworldqa-vlmeval-parity-qvac-sdk-unified-0182 node scripts/audit-showcase-vlmeval-parity.mjs",
    "showcase:audit:prepare-prompt-ablation": "node scripts/prepare-realworldqa-prompt-ablation.mjs",
    "showcase:test:prompt-ablation-120": "node scripts/run-realworldqa-prompt-ablation-120.mjs",
    "showcase:audit:methodology": "node scripts/audit-showcase-methodology.mjs",
    "showcase:test:preprocess-ablation": "node scripts/run-showcase-standard-preprocess-ablation.mjs",
    "soak:timeout": "node scripts/runtime-timeout-soak.mjs",
    "arena:audit": "node scripts/arena-audit.mjs",
    "arena:verify": "node scripts/arena-verify.mjs",
    "arena:test:integration": "node scripts/arena-fake-api-integration.mjs",
    "arena:smoke": "node scripts/arena-smoke.mjs",
    "arena:soak": "node scripts/arena-soak.mjs",
    "qvac:replica:status": "node scripts/qvac-official-replication.mjs status",
    "qvac:replica:plan": "node scripts/qvac-official-replication.mjs plan",
    "qvac:replica:command": "node scripts/qvac-official-replication.mjs command",
    "qvac:replica:start": "node scripts/qvac-mps-runner.mjs start",
    "qvac:replica:progress": "node scripts/qvac-mps-runner.mjs status",
    "qvac:replica:pause": "node scripts/qvac-mps-runner.mjs pause",
    "qvac:replica:leaderboard": "sh scripts/run-qvac-partial-leaderboard.sh",
    "qvac:replica:pope-leaderboard": "sh scripts/run-qvac-pope-leaderboard.sh",
    "qvac:replica:report": "node scripts/qvac-benchmark-report.mjs",
    "qvac:replica:inventory": "node scripts/qvac-benchmark-inventory.mjs --suite full --write",
    "qvac:replica:datasets": "sh scripts/run-qvac-prepare-datasets.sh",
    "challenge:generate": "node scripts/generate-challenge-pack.mjs",
    "challenge:install": "node scripts/install-challenge-pack.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.17"
  },
  "dependencies": {
    "@qvac/llm-llamacpp": "0.47.0",
    "@qvac/sdk": "0.18.2",
    "exifr": "7.1.3",
    "sharp": "0.35.4"
  },
  "overrides": {
    "@qvac/sdk": {
      "@qvac/llm-llamacpp": "0.47.0"
    }
  }
}
